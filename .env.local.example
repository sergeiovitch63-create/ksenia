# Supabase (stockage des avis)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (pour les liens d'approbation dans Telegram)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret pour signer les liens d'approbation d'avis
AVIS_APPROVAL_SECRET=remplacer-par-une-chaine-aleatoire-longue

# Mot de passe admin /admin/avis (fallback)
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-fort

# Telegram — toutes les notifications passent par là
# Bot créé via @BotFather, chat_id via /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
